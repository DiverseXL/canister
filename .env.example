# Copy to .env and adjust for local development.
# Canister reads these with os.environ.get(...) and ships safe defaults.

# FalkorDB connection. One graph is created per tenant id.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# FalkorDB cloud accepts a full rediss:// URL; if set it wins over host/port.
# FALKORDB_URL=rediss://default:password@host:port

# Tenant used by the API when a request does not specify one.
CANISTER_DEFAULT_TENANT=demo

# SQLite FTS5 index location (BM25 candidates).
CANISTER_INDEX_PATH=var/index.sqlite3

# Corpus artifacts.
CANISTER_CORPUS_DIR=corpus/out
